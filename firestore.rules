rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Perfil del atleta / paciente con aislamiento estricto
    match /users/{userId} {
      allow read, create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'balance']);
      allow delete: if false;

      // Sesiones de entrenamiento y registros glucémicos
      match /sessions/{sessionId} {
        allow read, create: if isAuthenticated() && request.auth.uid == userId;
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if false; // Invariante de preservación de historial médico
      }
    }

    // Catálogo global de ejercicios (solo lectura pública para la app)
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if false;
    }

    // Denegación por defecto de cualquier otra ruta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
